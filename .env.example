# ─────────────────────────────────────────────────────────────
# MARCHÉS PUBLICS KIT - Variables d'environnement
# ─────────────────────────────────────────────────────────────
# Copier vers .env et remplir TOUTES les valeurs
# NE PAS COMMITTER .env (dans .gitignore)

# ─────────────────────────────────────────────────────────────
# DOMAINES (Configurer DNS A records vers IP Proxmox)
# ─────────────────────────────────────────────────────────────
DOMAIN=marches-partner.tg
N8N_HOST=n8n.marches-partner.tg
WEBAPP_HOST=app.marches-partner.tg
METABASE_HOST=metabase.marches-partner.tg

# ─────────────────────────────────────────────────────────────
# POSTGRESQL (Générer mot de passe fort : openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS_MIN

# ─────────────────────────────────────────────────────────────
# N8N (Générer : openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_AUTH_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_ENCRYPTION_KEY

# ─────────────────────────────────────────────────────────────
# NEXTAUTH (Webapp) - Générer : openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_32_CHARS
NEXTAUTH_URL=https://app.marches-partner.tg

# ─────────────────────────────────────────────────────────────
# METABASE
# ─────────────────────────────────────────────────────────────
METABASE_ENCRYPTION_KEY=CHANGE_ME_METABASE_ENCRYPTION_KEY
METABASE_ADMIN_USER=admin
METABASE_ADMIN_PASSWORD=CHANGE_ME_METABASE_PASSWORD

# ─────────────────────────────────────────────────────────────
# SMTP (Brevo / SendGrid / Mailgun / Ovh / Gmail App Password)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login
SMTP_PASSWORD=your_brevo_smtp_key
EMAIL_FROM=noreply@marches-partner.tg

# ─────────────────────────────────────────────────────────────
# TELEGRAM BOT (Créer via @BotFather)
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890

# ─────────────────────────────────────────────────────────────
# OPTIONNEL - SENTRY / MONITORING
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=